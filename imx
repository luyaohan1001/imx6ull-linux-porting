# The busybox .config is hand-tuned and tracked (SYNC skips .config).
# Runtime libraries come from the toolchain's glibc; /etc comes from
# rootfs-porting/overlay.
ROOTFS_FULL = SYNC + '''
cp /repo/$PREFIX.config .config
[ "$MODE" = menuconfig ] && make menuconfig
make clean
make -j$(nproc)
rm -rf /build/rootfs && mkdir /build/rootfs
make install CONFIG_PREFIX=/build/rootfs
cd /build/rootfs
