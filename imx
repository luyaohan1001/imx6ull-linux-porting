# For clangd: the compile command of every object (first line of its
# .o.cmd), the headers that exist only in the build tree (generated ones,
# asm/arch links), and the cross compiler's own headers.
COMPDB = r'''
cd /build/$TREE
rm -rf /out/lsp && mkdir -p /out/lsp/gen
find . -name "*.o.cmd" -print0 | xargs -0 head -qn1 > /out/lsp/cmds.txt
find -L . -path ./include/config -prune -o -name "*.h" -print | while read -r f; do
    [ -e "/repo/$PREFIX$f" ] || cp --parents -L "$f" /out/lsp/gen/
done
cp -rL /usr/lib/gcc-cross/arm-linux-gnueabihf/5/include /out/lsp/gcc-include
echo "$(wc -l < /out/lsp/cmds.txt) commands, $(find /out/lsp/gen -type f | wc -l) build-only headers"
'''

# gcc options clang rejects or warns about.
GCC_ONLY = re.compile(r"-Wp,-MD,.*|-fno-ipa-sra|-fno-var-tracking-assignments|"
                      r"-fconserve-stack|--param=.*|-mno-thumb-interwork|"
                      r"-mapcs|-mword-relocations|-fno-partial-inlining|"
                      r"-Wno-unused-but-set-variable|-mno-unaligned-access|"
                      r"-fno-toplevel-reorder|-ffixed-r9|-fstack-usage|"
                      r"-Wno-maybe-uninitialized|-Wno-unused-const-variable|"
                      r"-fno-delete-null-pointer-checks|-mabi=apcs-gnu|"
                      r"-Werror=date-time|-fno-reorder-blocks|-fno-ipa-cp-clone|"
                      r"-mthumb-interwork")


def write_compdb(tree):
    lsp = os.path.join(tree, "out", "lsp")
    gen = os.path.join(lsp, "gen")
    entries = []
    for line in open(os.path.join(lsp, "cmds.txt"), errors="replace"):
        if " := " not in line:
            continue
        args = []
        for a in shlex.split(line.split(" := ", 1)[1]):
            if a.startswith(";"):
                break
            args.append(a.rstrip(";"))
            if a.endswith(";"):
                break
        srcs = [a for a in args if a.endswith(".c")]
        if not srcs or not args[0].endswith("gcc"):
            continue
        out = ["clang", "--target=arm-linux-gnueabihf",
               "-Wno-unknown-warning-option"]
        it = iter(args[1:])
        for a in it:
            if GCC_ONLY.fullmatch(a):
                continue
            if a.startswith("-D"):
                a = a.replace("\\#", "#")     # gcc takes "\#s", clang wants "#s"
            if a == "-isystem":
                next(it)
                out += ["-isystem", os.path.join(lsp, "gcc-include")]
                continue
            if a in ("-I", "-include", "-o"):
                a += " " + next(it)
            out += a.split(" ", 1) if a.startswith(("-I ", "-include ",
                                                   "-o ")) else [a]
            if a.startswith("-I"):
                d = os.path.normpath(os.path.join(gen, a[2:].strip()))
                if os.path.isdir(d):
                    out.append("-I" + d)
        # Headers generated next to their source ("timeconst.h").
        d = os.path.join(gen, os.path.dirname(srcs[-1]))
        if os.path.isdir(d):
            out += ["-iquote", d]
        entries.append({"directory": tree,
                        "file": os.path.join(tree, srcs[-1]),
                        "arguments": out})
    path = os.path.join(tree, "compile_commands.json")
    with open(path, "w") as f:
        json.dump(entries, f, indent=1)
    print(f"{path}: {len(entries)} files")


def compdb(trees=(KERNEL, UBOOT)):
    rc = 0
    for tree in trees:
        print(f"--- compile_commands.json for {os.path.basename(tree)}")
        rc |= docker_build(tree, COMPDB)
        if not rc:
            write_compdb(tree)
    return rc


UUU_SCRIPT = f'''uuu_version 1.2.39
SDP: boot -f {{uboot}} -nojump
SDP: write -f {{zimage}} -addr {KERNEL_ADDR}
SDP: write -f {{dtb}} -addr {DTB_ADDR}
{{ramdisk}}SDP: jump -f {{uboot}} -ivt
'''


def docker_build(tree, script, mode="", out=None):
    subprocess.check_call(["docker", "build", "-q", "-t", IMAGE, "-"],
                          stdin=open(os.path.join(ROOT, "Dockerfile.imx")),
                          stdout=subprocess.DEVNULL)
    subprocess.check_call(["docker", "volume", "create", VOLUME],
                          stdout=subprocess.DEVNULL)
    out = out or os.path.join(tree, "out")
    os.makedirs(out, exist_ok=True)
    tty = ["-it"] if sys.stdin.isatty() else []
    cmd = ["docker", "run", "--rm", *tty,
           "-v", f"{ROOT}:/repo:ro", "-v", f"{VOLUME}:/build", "-v", f"{out}:/out",
           "-e", f"PREFIX={os.path.relpath(tree, ROOT)}/",
           "-e", f"TREE={os.path.basename(tree)}", "-e", f"MODE={mode}",
           "-e", "KMODS=" + os.path.relpath(
               os.path.join(KERNEL, "out", "modules", "lib", "modules"), ROOT),
           IMAGE, "bash", "-ec", script]
    return subprocess.call(cmd)


def find_serial():
    """The board's USB-serial console (override with IMX_SERIAL)."""
    if os.environ.get("IMX_SERIAL"):
        return os.environ["IMX_SERIAL"]
    for pattern in ("/dev/cu.usbserial-*", "/dev/cu.wchusbserial*",
                    "/dev/cu.SLAB_USBtoUART*", "/dev/cu.usbmodem*"):
        ports = sorted(glob.glob(pattern))
        if ports:
            return ports[0]
    return None


def run_uuu(script):
    """Run uuu and stop it once the final SDP jump is done.

    After the jump the board leaves serial download mode and runs U-Boot,
    but uuu keeps waiting for a next-stage device that never comes.
    """
    proc = subprocess.Popen(["sudo", "uuu", "-v", script], cwd=ROOT,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    seen = b""
    jumped_at = None
    while True:
        ready, _, _ = select.select([proc.stdout], [], [], 0.2)
        if ready:
            chunk = os.read(proc.stdout.fileno(), 4096)
            if not chunk:
                break
            sys.stdout.buffer.write(chunk)
            sys.stdout.flush()
            seen += chunk
            # Verbose mode: "Start Cmd:SDP: jump ..." then "Okay"; progress
            # bar: "5/ 5 [===100%===] SDP: jump ..." on one line.
            i = seen.find(b"SDP: jump")
            lines = re.split(rb"[\r\n]", seen)
            if jumped_at is None and i >= 0 and (
                    b"Okay" in seen[i:] or
                    any(b"SDP: jump" in l and b"100%" in l for l in lines)):
                jumped_at = time.time()
        if proc.poll() is not None:
            break
        if jumped_at and time.time() - jumped_at > 0.2:
            # Be quick: U-Boot's autoboot countdown is only 3 s.
            for sig in (signal.SIGINT, signal.SIGTERM):   # sudo relays both
                proc.send_signal(sig)
                try:
                    proc.wait(timeout=0.5)
                    break
                except subprocess.TimeoutExpired:
                    pass
            return 0
    return proc.wait()


def uboot_console(port, commands, timeout=15):
    """Stop U-Boot's autoboot on the serial console and type commands."""
    fd = os.open(port, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        tty.setraw(fd, termios.TCSANOW)     # don't flush what already arrived
        attrs = termios.tcgetattr(fd)
        attrs[2] |= termios.CLOCAL | termios.CREAD
        attrs[4] = attrs[5] = termios.B115200
        termios.tcsetattr(fd, termios.TCSANOW, attrs)

        def read(wait):
            data = b""
            end = time.time() + wait
            while time.time() < end:
                if select.select([fd], [], [], 0.05)[0]:
                    try:
                        data += os.read(fd, 4096)
                    except BlockingIOError:
                        pass
            sys.stdout.buffer.write(data)
            sys.stdout.flush()
            return data

        seen = b""
        deadline = time.time() + timeout
        tries = 0
        while b"=> " not in seen[-200:]:
            if time.time() > deadline:
                return False
            # Any key stops the countdown; Ctrl-C leaves fastboot mode (also
            # sent now and then, in case the fastboot message was missed).
            tries += 1
            ctrl_c = b"astboot" in seen[-400:] or tries % 3 == 0
            os.write(fd, b"\x03" if ctrl_c else b"\r")
            seen += read(0.2)
        for cmd in commands:
            os.write(fd, cmd.encode() + b"\r")
            read(0.3)
        return True
    finally:
        os.close(fd)


def load(target):
    files = {
        "uboot": os.path.join(UBOOT, "out", "u-boot.imx"),
        "zimage": os.path.join(KERNEL, "out", "zImage"),
        "dtb": os.path.join(KERNEL, "out", DTB),
    }
    ramdisk = os.path.join(ROOTFS, "out", "uRamdisk")
    missing = [f for f in files.values() if not os.path.exists(f)]
    if missing:
        sys.exit("missing (run `imx uboot` / `imx` first):\n  " +
                 "\n  ".join(missing))
    if not target:
        target = "ramdisk" if os.path.exists(ramdisk) else "emmc"
    if target == "ramdisk" and not os.path.exists(ramdisk):
        sys.exit(f"missing (run `imx rootfs` first):\n  {ramdisk}")

    k, d, r = KERNEL_ADDR[2:], DTB_ADDR[2:], RAMDISK_ADDR[2:]
    commands = {
        "ramdisk": ["setenv bootargs 'console=ttymxc0,115200 "
                    "kgdboc=ttymxc0,115200'",
                    f"bootz {k} {r} {d}"],
        "emmc": ["setenv bootargs 'console=ttymxc0,115200 kgdboc=ttymxc0,115200 "
                 "root=/dev/mmcblk1p2 rootwait rw'", f"bootz {k} - {d}"],
        "prompt": [],
    }[target]

    # uuu resolves script paths relative to the script's directory (and
    # mangles quoted absolute paths), so keep the script and paths in ROOT.
    rel = {k: os.path.relpath(v, ROOT) for k, v in files.items()}
    rel["ramdisk"] = ""
    if target != "emmc" and os.path.exists(ramdisk):
        rel["ramdisk"] = (f"SDP: write -f {os.path.relpath(ramdisk, ROOT)} "
                          f"-addr {RAMDISK_ADDR}\n")
    port = find_serial()
    print("Board: boot switches in USB download mode (01000000), OTG and "
          "USB_TTL cables in, power on.")
    print(f"Serial console: {port or 'not found (set IMX_SERIAL)'}\n")
    if subprocess.call(["sudo", "-v"]) != 0:     # ask for the password now
        return 1

    with tempfile.NamedTemporaryFile("w", suffix=".uuu", prefix=".imx-load-",
                                     dir=ROOT, delete=False) as f:
        f.write(UUU_SCRIPT.format(**rel))
    try:
        rc = run_uuu(os.path.basename(f.name))
    finally:
        os.unlink(f.name)
    if rc != 0:
        return rc

    if not port:
        print("\nNo serial port found. In the U-Boot console type:\n  " +
              "\n  ".join(commands))
        return 0
    print(f"\n--- {port}: stopping autoboot, booting {target} ---")
    if not uboot_console(port, commands):
        print("\nNo U-Boot prompt seen; opening the console anyway.")
    time.sleep(0.5)
    print("\n--- screen: Ctrl-A K Y to quit ---")
    os.execvp("screen", ["screen", port, "115200"])


# Out-of-tree module: copied into the case-sensitive volume next to the kernel
# build tree (which has the matching .config and Module.symvers) and built
# with the kernel's own Makefile.
MODULE_BUILD = r'''
rm -rf /build/modules/$NAME && mkdir -p /build/modules
cp -r "/repo/$MODDIR" /build/modules/$NAME && rm -rf /build/modules/$NAME/out
make -C /build/$KTREE M=/build/modules/$NAME modules
cp /build/modules/$NAME/*.ko /out/
ls -l /out
'''


def build_module(path):
    path = os.path.abspath(path or os.path.join(ROOT, "modules", "hello"))
    if not os.path.exists(os.path.join(path, "Makefile")):
        sys.exit(f"no Makefile in {path}")
    if os.path.commonpath([path, ROOT]) != ROOT:
        sys.exit(f"module must be inside the repo: {path}")
    if not os.path.exists(os.path.join(KERNEL, "out", "vmlinux")):
        sys.exit("build the kernel first (imx): modules need its build tree")
    out = os.path.join(path, "out")
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)
    subprocess.check_call(["docker", "build", "-q", "-t", IMAGE, "-"],
                          stdin=open(os.path.join(ROOT, "Dockerfile.imx")),
                          stdout=subprocess.DEVNULL)
    rc = subprocess.call([
        "docker", "run", "--rm", "-v", f"{ROOT}:/repo:ro",
        "-v", f"{VOLUME}:/build", "-v", f"{out}:/out",
        "-e", f"NAME={os.path.basename(path)}",
        "-e", f"MODDIR={os.path.relpath(path, ROOT)}",
        "-e", f"KTREE={os.path.basename(KERNEL)}",
        IMAGE, "bash", "-ec", MODULE_BUILD])
    if rc == 0:
        ko = os.path.join(KERNEL, "out", "ko")       # served by imx qemu's TFTP
        os.makedirs(ko, exist_ok=True)
        for f in glob.glob(os.path.join(out, "*.ko")):
            shutil.copy(f, ko)
            print(f"{os.path.relpath(f)} -> in QEMU: "
                  f"tftp -g -r {os.path.basename(f)} 10.0.2.2")
    return rc


def qemu(extra):
    """Boot the kernel and our rootfs (as initramfs) in QEMU.

    QEMU's mcimx6ul-evk emulates the i.MX6UL, so this uses the 6UL EVK
    device tree adapted in qemu/imx6ul-qemu.dts, not the board's.
    """
    files = [os.path.join(KERNEL, "out", "zImage"),
             os.path.join(KERNEL, "out", "imx6ul-qemu.dtb"),
             os.path.join(ROOTFS, "out", "rootfs.cpio.gz")]
    if not os.path.exists(files[1]):
        # Kernels built before `imx qemu` existed lack both the QEMU dtb
        # and the clk.c fix QEMU needs, so rebuild the kernel first.
        print("No QEMU device tree yet: building the kernel first (imx).\n")
        if docker_build(KERNEL, KERNEL_FULL) or compdb([KERNEL]):
            return 1
    if not os.path.exists(files[2]):
        print("No rootfs yet: building it first (imx rootfs).\n")
        if docker_build(BUSYBOX, ROOTFS_FULL, out=os.path.join(ROOTFS, "out")):
            return 1
    missing = [f for f in files if not os.path.exists(f)]
    if missing:
        sys.exit("missing (run `imx` / `imx rootfs` first):\n  " +
                 "\n  ".join(missing))
    if not shutil.which("qemu-system-arm"):
        sys.exit("qemu-system-arm not found (brew install qemu)")
    if extra[:1] == ["debug"]:
        # -S: don't start the CPU; -gdb: gdb server
        extra = ["-S", "-gdb", f"tcp::{GDB_PORT}"] + extra[1:]
        print("QEMU is paused, waiting for gdb: run `imx gdb` in another "
              "terminal.\n")
    print("QEMU mcimx6ul-evk: press Enter at 'Please press Enter...'. "
          "To quit, type `reboot` (or Ctrl-A X); Ctrl-A C toggles the QEMU "
          "monitor.\n")
    # User-mode network on ENET1 (Linux eth1; QEMU connects the first NIC to
    # ENET1 at 0x02188000). The guest is 10.0.2.15 (set by the kernel via ip=),
    # the Mac is 10.0.2.2, and QEMU's TFTP server there serves out/ko, so a
    # rebuilt module is one `tftp -g -r foo.ko 10.0.2.2` away.
    ko = os.path.join(KERNEL, "out", "ko")
    os.makedirs(ko, exist_ok=True)
    # -no-reboot: a guest reboot exits QEMU instead of restarting it.
    os.execvp("qemu-system-arm", [
        "qemu-system-arm", "-M", "mcimx6ul-evk", "-m", "512M", "-nographic",
        "-no-reboot", "-nic", f"user,tftp={ko}",
        "-kernel", files[0], "-dtb", files[1], "-initrd", files[2],
        "-append", "console=ttymxc0,115200 kgdboc=ttymxc0,115200 "
                   "ip=10.0.2.15::10.0.2.2:255.255.255.0::eth1:off", *extra])


# Kernel entry and root-filesystem entry points, in boot order (keep in sync
# with .vscode/launch.json).
BOOT_BREAKPOINTS = ["stext", "start_kernel", "populate_rootfs",
                    "prepare_namespace", "run_init_process"]


def find_arm_gdb():
    for name in ("arm-none-eabi-gdb", "gdb-multiarch", "arm-linux-gnueabihf-gdb"):
        if shutil.which(name):
            return shutil.which(name)
    found = sorted(glob.glob("/Applications/ArmGNUToolchain/*/arm-none-eabi/"
                             "bin/arm-none-eabi-gdb"))
    return found[-1] if found else None


def gdb(extra):
    """gdb on vmlinux, attached to QEMU started with `imx qemu debug`.

    PAGE_OFFSET (0x80000000) equals the DDR base here, so kernel symbols are
    also valid before the MMU is on: hardware breakpoints in head.S work.
    """
    vmlinux = os.path.join(KERNEL, "out", "vmlinux")
    if not os.path.exists(vmlinux):
        sys.exit(f"missing (run `imx` first):\n  {vmlinux}")
    arm_gdb = find_arm_gdb()
    if not arm_gdb:
        sys.exit("no ARM gdb found (install the Arm GNU Toolchain: "
                 "arm-none-eabi-gdb)")
    build = "/build/" + os.path.basename(KERNEL)     # path in the DWARF info
    print("""Breakpoints, in boot order (`c` goes from one to the next):
  stext              first kernel instruction (head.S, MMU off)
  start_kernel       first C function (init/main.c)
  populate_rootfs    unpacks the initramfs (rootfs.cpio.gz)
  prepare_namespace  mounts root= from disk (only without an initramfs /init)
  run_init_process   execs /init: kernel -> rootfs user space
Commands:
  c                 continue          si / ni    step one instruction
  b <function>      breakpoint        s / n      step a source line
  layout src / layout asm             info registers, bt, x/8i $pc
""")
    os.execvp(arm_gdb, [
        arm_gdb, "-q", vmlinux,
        "-ex", "set pagination off",
        # The decompressor writes the kernel over software breakpoints; a
        # read-only region over .text + .init makes gdb use hardware ones.
        "-ex", "set mem inaccessible-by-default off",
        "-ex", "mem 0x80008000 0x80990000 ro",
        "-ex", f"set substitute-path {build} {KERNEL}",
        "-ex", f"target remote localhost:{GDB_PORT}",
        *[a for f in BOOT_BREAKPOINTS for a in ("-ex", f"hbreak {f}")],
        *extra])


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode in ("", "menuconfig"):
        rc = docker_build(KERNEL, KERNEL_FULL, mode) or compdb([KERNEL])
        if rc == 0 and mode == "menuconfig":
            defconfig = os.path.join(KERNEL, "arch", "arm", "configs",
                                     "imx_alientek_emmc_defconfig")
            print(f"""
The build used your menuconfig choices. To keep them for future builds:
  cp {os.path.relpath(os.path.join(KERNEL, "out", "defconfig"))} \\
     {os.path.relpath(defconfig)}""")
    elif mode == "dtbs":
        rc = docker_build(KERNEL, KERNEL_DTBS)
    elif mode == "uboot":
        rc = docker_build(UBOOT, UBOOT_FULL) or compdb([UBOOT])
    elif mode == "rootfs":
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub not in ("", "menuconfig"):
            sys.exit(__doc__)
        rc = docker_build(BUSYBOX, ROOTFS_FULL, sub,
                          out=os.path.join(ROOTFS, "out"))
    elif mode == "compdb":
        rc = compdb()
    elif mode == "module":
        rc = build_module(sys.argv[2] if len(sys.argv) > 2 else "")
    elif mode == "qemu":
        rc = qemu(sys.argv[2:])
    elif mode == "gdb":
        rc = gdb(sys.argv[2:])
    elif mode == "load":
        sub = sys.argv[2] if len(sys.argv) > 2 else ""
        if sub not in ("", "ramdisk", "emmc", "prompt"):
            sys.exit(__doc__)
        rc = load(sub)
    else:
        sys.exit(__doc__)
    sys.exit(rc)


if __name__ == "__main__":
    main()
